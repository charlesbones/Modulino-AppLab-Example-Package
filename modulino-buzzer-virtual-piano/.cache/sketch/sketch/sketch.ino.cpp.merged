#include <Arduino_RouterBridge.h>
#include <Arduino_Modulino.h>

ModulinoBuzzer buzzer;

String rpc_play_note(int frequency) {
  buzzer.tone(frequency, 300);
  return "{\"status\":\"ok\"}";
}

void setup() {
  Bridge.begin();
  Modulino.begin();
  buzzer.begin();
  Bridge.provide("play_note", rpc_play_note);
}

void loop() {
  // Bridge handles RPC on a background thread; nothing needed here.
}

