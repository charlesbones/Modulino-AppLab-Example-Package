/*
 * Modulino Hub — Multi-Channel Dashboard
 *
 * The Modulino Hub is an 8-channel I²C multiplexer. It lets you connect
 * several nodes that share the same default address by isolating each one
 * on its own channel. This sketch enables each channel in turn, scans the
 * Modulino bus for devices, identifies each node, and reports what it finds
 * per channel to Python via Bridge.
 *
 * Hardware: Arduino UNO Q + Modulino Hub (Qwiic) + one or more Modulino nodes
 */

#include <Arduino_RouterBridge.h>
#include <Arduino_Modulino.h>
#include "Wire.h"

ModulinoHub hub;                 // 8-channel I²C multiplexer, default address 0x70
const int NUM_CHANNELS = 8;

// ── Node identification (shared with the Address Changer example) ─────────────
static const uint8_t FIXED_ADDRS[] = { 0x29, 0x44, 0x53, 0x6A, 0x6B };

static bool isFixedAddr(uint8_t addr) {
  for (uint8_t a : FIXED_ADDRS) if (a == addr) return true;
  return false;
}

static String fixedAddrToName(uint8_t addr) {
  switch (addr) {
    case 0x29: return "Distance";
    case 0x44: return "Thermo";
    case 0x53: return "Light";
    case 0x6A:
    case 0x6B: return "Movement";
    default:   return "Unknown";
  }
}

// Pinstrap = byte read from register 0x00 of a configurable node.
static String pinstrapToName(uint8_t pinstrap) {
  switch (pinstrap) {
    case 0x04: return "Latch Relay";
    case 0x28: return "Opto Relay";
    case 0x3C: return "Buzzer";
    case 0x58: return "Joystick";
    case 0x6C: return "Pixels";
    case 0x70: return "Vibro";
    case 0x74:
    case 0x76: return "Knob";
    case 0x72: return "LED Matrix";
    case 0x7C: return "Buttons";
    default:   return "Unknown";
  }
}

static String identify(uint8_t addr) {
  if (isFixedAddr(addr)) return fixedAddrToName(addr);
  // Configurable node: read the pinstrap register.
  Wire1.beginTransmission(addr);
  Wire1.write(0x00);
  Wire1.endTransmission();
  delay(20);
  Wire1.requestFrom((int)addr, 1);
  if (Wire1.available()) {
    uint8_t pinstrap = Wire1.read();
    while (Wire1.available()) Wire1.read();
    return pinstrapToName(pinstrap);
  }
  return "Unknown";
}

// ── Scan one channel: enable it, list devices, disable it ────────────────────
static void scanChannel(int ch) {
  hub.select(ch);
  delay(5);

  for (int addr = 8; addr <= 0x77; addr++) {
    if (addr == hub.address()) continue;   // skip the hub itself
    Wire1.beginTransmission(addr);
    if (Wire1.endTransmission() != 0) continue;
    Bridge.notify("device_found", ch, addr, identify((uint8_t)addr));
  }

  hub.clear();
}

static void scanAll() {
  Bridge.notify("scan_start");
  for (int ch = 0; ch < NUM_CHANNELS; ch++) {
    scanChannel(ch);
  }
  Bridge.notify("scan_complete");
}

// ── RPC ──────────────────────────────────────────────────────────────────────
bool rescan() {
  scanAll();
  return true;
}

void setup() {
  Wire1.begin();
  Bridge.begin();
  Modulino.begin();

  Bridge.provide_safe("rescan", rescan);
  delay(600);   // let Python register its Bridge handlers before the first scan
  scanAll();
}

void loop() {}

