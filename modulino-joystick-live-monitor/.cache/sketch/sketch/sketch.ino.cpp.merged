/*
 * Modulino Joystick — Live Monitor
 *
 * Streams X/Y axis changes to Python via Bridge.notify("joystick_event").
 * Uses Button2 to detect press, release, and double-tap events on the
 * joystick click button and pushes them via Bridge.notify("button_event").
 *
 * Hardware: Arduino UNO Q + Modulino Joystick (Qwiic)
 */

#include <Arduino_RouterBridge.h>
#include <Arduino_Modulino.h>
#include <Button2.h>

// ── Modulino + Button2 objects ────────────────────────────────────
ModulinoJoystick joystick;
Button2 btn;

// ── Last-known axis values to detect changes ──────────────────────
int8_t lastX = 0, lastY = 0;

// ── Button2 state function: reads the joystick click button ───────
// Calling joystick.update() here keeps the hardware state fresh
// whenever Button2 polls this function.
uint8_t joystickBtnState() {
  joystick.update();
  return joystick.isPressed() ? LOW : HIGH;
}

// ── RPC: snapshot for on-connect ─────────────────────────────────
String rpc_get_state() {
  joystick.update();
  return "{\"x\":" + String((int)joystick.getX()) +
         ",\"y\":" + String((int)joystick.getY()) + "}";
}

// ── Button2 event handlers ────────────────────────────────────────
void onPress(Button2& b)       { Bridge.notify("button_event", "press"); }
void onRelease(Button2& b)     { Bridge.notify("button_event", "release"); }
void onDoubleClick(Button2& b) { Bridge.notify("button_event", "double_tap"); }

void setup() {
  Bridge.begin();
  Modulino.begin();
  joystick.begin();

  btn.setDebounceTime(35);
  btn.setButtonStateFunction(joystickBtnState);
  btn.setPressedHandler(onPress);
  btn.setReleasedHandler(onRelease);
  btn.setDoubleClickHandler(onDoubleClick);
  btn.begin(BTN_VIRTUAL_PIN);

  Bridge.provide("get_state", rpc_get_state);
}

void loop() {
  // Button2 drives joystick.update() via joystickBtnState();
  // we read axis values afterwards so they're always fresh.
  btn.loop();

  int8_t x = joystick.getX();
  int8_t y = joystick.getY();
  if (x != lastX || y != lastY) {
    lastX = x;
    lastY = y;
    Bridge.notify("joystick_event", (int)x, (int)y);
  }
}

