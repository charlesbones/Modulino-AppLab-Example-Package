#include <Arduino_RouterBridge.h>
#include "Modulino_LED_Matrix.h"

// NOTE: ModulinoLEDMatrix uses Wire1 and initialises itself in begin().
// Do NOT call Modulino.begin() here.

ModulinoLEDMatrix matrix;

bool pixels[8][12];

String buildState() {
  String json = "{\"pixels\": [";
  for (int y = 0; y < 8; y++) {
    for (int x = 0; x < 12; x++) {
      json += pixels[y][x] ? "1" : "0";
      if (y < 7 || x < 11) json += ",";
    }
  }
  json += "]}";
  return json;
}

void redrawCanvas() {
  for (int y = 0; y < 8; y++) {
    for (int x = 0; x < 12; x++) {
      if (pixels[y][x]) {
        matrix.set(x, y, 255, 255, 255);
      } else {
        matrix.set(x, y, 0, 0, 0);
      }
    }
  }
  matrix.endDraw();
}

String rpc_get_state() {
  return buildState();
}

String rpc_toggle_pixel(int x, int y) {
  x = constrain(x, 0, 11);
  y = constrain(y, 0, 7);
  pixels[y][x] = !pixels[y][x];
  redrawCanvas();
  return buildState();
}

String rpc_clear_canvas() {
  for (int y = 0; y < 8; y++) {
    for (int x = 0; x < 12; x++) {
      pixels[y][x] = false;
    }
  }
  matrix.clear();
  matrix.endDraw();
  return buildState();
}

void setup() {
  Bridge.begin();
  matrix.begin();

  Bridge.provide("get_state",    rpc_get_state);
  Bridge.provide("toggle_pixel", rpc_toggle_pixel);
  Bridge.provide("clear_canvas", rpc_clear_canvas);
}

void loop() {
  // Nothing to drive — canvas is fully event-driven via RPC
}

