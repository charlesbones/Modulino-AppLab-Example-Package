//     matrix.endDraw();
//   }
//
// ────────────────────────────────────────────────────────────────────────────

void showIcon(int idx) {
  switch (idx) {
    case  0: matrix.setFrame(LEDMATRIX_BLUETOOTH);      break;
    case  1: matrix.setFrame(LEDMATRIX_BOOTLOADER_ON);  break;
    case  2: matrix.setFrame(LEDMATRIX_CHIP);           break;
    case  3: matrix.setFrame(LEDMATRIX_CLOUD_WIFI);     break;
    case  4: matrix.setFrame(LEDMATRIX_DANGER);         break;
    case  5: matrix.setFrame(LEDMATRIX_EMOJI_BASIC);    break;
    case  6: matrix.setFrame(LEDMATRIX_EMOJI_HAPPY);    break;
    case  7: matrix.setFrame(LEDMATRIX_EMOJI_SAD);      break;
    case  8: matrix.setFrame(LEDMATRIX_HEART_BIG);      break;
    case  9: matrix.setFrame(LEDMATRIX_HEART_SMALL);    break;
    case 10: matrix.setFrame(LEDMATRIX_LIKE);           break;
    case 11: matrix.setFrame(LEDMATRIX_MUSIC_NOTE);     break;
    case 12: matrix.setFrame(LEDMATRIX_RESISTOR);       break;
    case 13: matrix.setFrame(LEDMATRIX_UNO);            break;
  }
}

// ── Adding a custom icon designed in Pixel Canvas ────────────────────────────
//
// 1. In the modulino-led-matrix-pixel-canvas project, draw your icon and click
//    Copy to copy the exported array from the textarea below the canvas.
//    The export is a const uint8_t[16] array — 2 bytes per row, 8 rows.
//    byte[row*2+0]: cols 0-7  (col 0 = bit 7, MSB = leftmost)
//    byte[row*2+1]: cols 8-11 (col 8 = bit 7, lower nibble unused)
//
// 2. Paste the array above showIcon() and rename it:
//
//      const uint8_t MY_ICON[] = {
//        0b00000000, 0b00000000,  // row 0
//        0b01111110, 0b00000000,  // row 1
//        // ...
//      };
//
//    Add this helper once (before showIcon). It bridges the row-major export
//    format to matrix.set() calls (the gallery's uint32_t[3] setFrame format
//    is column-major and cannot be used directly with the pixel canvas export):
//
//      void showUInt8Icon(const uint8_t* p) {
//        for (int y = 0; y < 8; y++) {
//          for (int x = 0; x < 8; x++)
//            matrix.set(x, y, (p[y*2]   >> (7-x)) & 1 ? 255 : 0, 0, 0);
//          for (int x = 8; x < 12; x++)
//            matrix.set(x, y, (p[y*2+1] >> (15-x)) & 1 ? 255 : 0, 0, 0);
//        }
//        matrix.endDraw();
//      }
//
// 3. Increment NUM_ICONS at the top of this file:
//      const int NUM_ICONS = 15;   // was 14
//
// 4. Add a new case to showIcon() (before the closing brace):
//      case 14: showUInt8Icon(MY_ICON); break;
//
// 5. Add the icon label to the ICONS array in ui/app.js so the button appears:
//      var ICONS = [ "Bluetooth", ..., "UNO", "My Icon" ];
//      (the array must have exactly NUM_ICONS entries)
//
// ─────────────────────────────────────────────────────────────────────────────

void startAnimation(int idx) {
  switch (idx) {
    case  0: matrix.setSequence(LEDMATRIX_ANIMATION_STARTUP);              break;
    case  1: matrix.setSequence(LEDMATRIX_ANIMATION_TETRIS_INTRO);         break;
    case  2: matrix.setSequence(LEDMATRIX_ANIMATION_ATMEGA);               break;
    case  3: matrix.setSequence(LEDMATRIX_ANIMATION_LED_BLINK_HORIZONTAL); break;
    case  4: matrix.setSequence(LEDMATRIX_ANIMATION_LED_BLINK_VERTICAL);   break;
    case  5: matrix.setSequence(LEDMATRIX_ANIMATION_ARROWS_COMPASS);       break;
    case  6: matrix.setSequence(LEDMATRIX_ANIMATION_AUDIO_WAVEFORM);       break;
    case  7: matrix.setSequence(LEDMATRIX_ANIMATION_BATTERY);              break;
    case  8: matrix.setSequence(LEDMATRIX_ANIMATION_BOUNCING_BALL);        break;
    case  9: matrix.setSequence(LEDMATRIX_ANIMATION_BUG);                  break;
    case 10: matrix.setSequence(LEDMATRIX_ANIMATION_CHECK);                break;
    case 11: matrix.setSequence(LEDMATRIX_ANIMATION_CLOUD);                break;
    case 12: matrix.setSequence(LEDMATRIX_ANIMATION_DOWNLOAD);             break;
    case 13: matrix.setSequence(LEDMATRIX_ANIMATION_DVD);                  break;
    case 14: matrix.setSequence(LEDMATRIX_ANIMATION_HEARTBEAT_LINE);       break;
    case 15: matrix.setSequence(LEDMATRIX_ANIMATION_HEARTBEAT);            break;
    case 16: matrix.setSequence(LEDMATRIX_ANIMATION_INFINITY_LOOP_LOADER); break;
    case 17: matrix.setSequence(LEDMATRIX_ANIMATION_LOAD_CLOCK);           break;
    case 18: matrix.setSequence(LEDMATRIX_ANIMATION_LOAD);                 break;
    case 19: matrix.setSequence(LEDMATRIX_ANIMATION_LOCK);                 break;
    case 20: matrix.setSequence(LEDMATRIX_ANIMATION_NOTIFICATION);         break;
    case 21: matrix.setSequence(LEDMATRIX_ANIMATION_OPENSOURCE);           break;
    case 22: matrix.setSequence(LEDMATRIX_ANIMATION_SPINNING_COIN);        break;
    case 23: matrix.setSequence(LEDMATRIX_ANIMATION_TETRIS);               break;
    case 24: matrix.setSequence(LEDMATRIX_ANIMATION_WIFI_SEARCH);          break;
    case 25: matrix.setSequence(LEDMATRIX_ANIMATION_HOURGLASS);            break;
  }
  matrix.nextFrame(); // render frame 0 immediately; populates getCurrentDuration()
  last_frame_ms = millis();
}

String rpc_get_state() {
  return buildState();
}

String rpc_show_item(int index) {
  anim_mode = 0;
  index = constrain(index, 0, NUM_ICONS + NUM_ANIMS - 1);
  selected_item = index;
  scroll_text_val = "";
  if (index < NUM_ICONS) {
    showIcon(index);
    // anim_mode stays 0 — icons are static
  } else {
    startAnimation(index - NUM_ICONS);
    anim_mode = 1;
  }
  return buildState();
}

// Combined RPC for text transfer and scroll trigger.
// pos >= 0 : store 8 ASCII chars at text_buf[pos*8]; v1 holds chars 0-3
//            packed as (c0 | c1<<8 | c2<<16 | c3<<24), v2 holds chars 4-7.
// pos == -1: null-terminate at v1 and start scrolling immediately.
String rpc_text_op(int pos, int v1, int v2) {
  if (pos < 0) {
    int length = constrain(v1, 1, 64);
    text_buf[length] = '\0';
    scroll_text_val = String(text_buf);
    selected_item = 40;
    scroll_x = 12;    // reset: text enters from right edge
    anim_mode = 2;
  } else {
    int base = constrain(pos, 0, 7) * 8;
    text_buf[base + 0] = (char)((v1 >>  0) & 0x7F);
    text_buf[base + 1] = (char)((v1 >>  8) & 0x7F);
    text_buf[base + 2] = (char)((v1 >> 16) & 0x7F);
    text_buf[base + 3] = (char)((v1 >> 24) & 0x7F);
    text_buf[base + 4] = (char)((v2 >>  0) & 0x7F);
    text_buf[base + 5] = (char)((v2 >>  8) & 0x7F);
    text_buf[base + 6] = (char)((v2 >> 16) & 0x7F);
    text_buf[base + 7] = (char)((v2 >> 24) & 0x7F);
  }
  return buildState();
}

String rpc_stop() {
  anim_mode = 0;
  selected_item = -1;
  scroll_text_val = "";
  matrix.clear();
  matrix.endDraw();
  return buildState();
}

