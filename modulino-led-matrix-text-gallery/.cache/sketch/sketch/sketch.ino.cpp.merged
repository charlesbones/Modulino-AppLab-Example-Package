void setup() {
  Bridge.begin();
  matrix.begin();
  matrix.textFont(Font_5x7);  // required for text() to render characters

  Bridge.provide("get_state",  rpc_get_state);
  Bridge.provide("show_item",  rpc_show_item);
  Bridge.provide("text_op",    rpc_text_op);
  Bridge.provide("stop",       rpc_stop);

  // ── Canvas integration ────────────────────────────────────────────────────
  // Adding pixel-drawing increases the provide count beyond 4. To stay within
  // the Bridge limit, remove one of the existing RPCs or split into two
  // sketches (as in the modulino-led-matrix-pixel-canvas project).
  //   Bridge.provide("toggle_pixel", rpc_toggle_pixel);
  //   Bridge.provide("clear_canvas", rpc_clear_canvas);
  // ─────────────────────────────────────────────────────────────────────────
}

void loop() {
  if (anim_mode == 0) return;
  unsigned long now = millis();
  uint32_t dur = (anim_mode == 1) ? matrix.getCurrentDuration() : 80;
  if (dur < 50) dur = 50;
  if (now - last_frame_ms < dur) return;
  last_frame_ms = now;

  if (anim_mode == 1) {
    matrix.nextFrame();
  } else {
    // anim_mode == 2: non-blocking text scroll — one column per frame.
    // endText(SCROLL_LEFT) is NOT used because it calls delay() in a loop
    // and blocks the Bridge thread for the entire scroll duration.
    int fontWidth       = matrix.textFontWidth();
    int textPixelWidth  = (int)strlen(text_buf) * fontWidth;

    // Clear the canvas buffer without an extra hardware write, then
    // render the text at the current offset (clipped by the library).
    matrix.ArduinoGraphics::clear();
    matrix.stroke(255, 255, 255);
    matrix.text(text_buf, scroll_x, 0);
    matrix.endDraw();

    scroll_x--;
    if (scroll_x < -textPixelWidth) {
      scroll_x = 12;  // loop: text re-enters from the right
    }
  }
}

