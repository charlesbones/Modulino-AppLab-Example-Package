#include <Arduino_RouterBridge.h>
#include "Modulino_LED_Matrix.h"
#include "LEDMatrixGallery.h"

// NOTE: ModulinoLEDMatrix uses Wire1 and initialises itself in begin().
// Do NOT call Modulino.begin() here.

ModulinoLEDMatrix matrix;

volatile int anim_mode  = 0;  // 0 = idle/static icon, 1 = gallery anim, 2 = scroll text
int selected_item       = -1; // -1=none, 0-13=icon, 14-39=animation, 40=scroll text
String scroll_text_val  = "";

unsigned long last_frame_ms = 0;

const int NUM_ICONS = 14;
const int NUM_ANIMS = 26;

// Text buffer filled via rpc_text_op; scrolled non-blocking in loop().
// 8 ASCII chars are packed per call (4 per int arg) to minimise Bridge
// round-trips and stay well within the 10 s RPC timeout.
char text_buf[65];
int scroll_x = 12;  // current horizontal scroll offset; 12 = just off-screen right

// ── Canvas integration ───────────────────────────────────────────────────────
// To add pixel-drawing from the modulino-led-matrix-pixel-canvas project,
// insert the following variable declaration here:
//
//   bool pixels[8][12];
//
// ────────────────────────────────────────────────────────────────────────────

String buildState() {
  String json = "{\"mode\": " + String(anim_mode) +
                ", \"selected\": " + String(selected_item) +
                ", \"text\": \"" + scroll_text_val + "\"}";
  return json;
}

// ── Canvas integration ───────────────────────────────────────────────────────
// To add pixel-drawing from the modulino-led-matrix-pixel-canvas project,
// insert the redrawCanvas() function here:
//
//   void redrawCanvas() {
