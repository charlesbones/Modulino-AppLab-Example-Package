#include <Arduino_RouterBridge.h>
#include <Arduino_Modulino.h>

ModulinoVibro vibro;

int last_duration_ms = 500;
int last_power = 50;

String buildState() {
  return "{\"last_duration_ms\": " + String(last_duration_ms) +
         ", \"last_power\": " + String(last_power) + "}";
}

String rpc_get_state() {
  return buildState();
}

String rpc_buzz(int duration_ms, int power_level) {
  last_duration_ms = constrain(duration_ms, 50, 2000);
  last_power       = constrain(power_level, 25, 50);
  vibro.on((size_t)last_duration_ms, (VibroPowerLevel)last_power);
  return buildState();
}

String rpc_stop_buzz() {
  vibro.off();
  return buildState();
}

void setup() {
  Bridge.begin();
  Modulino.begin();
  vibro.begin();

  Bridge.provide("get_state", rpc_get_state);
  Bridge.provide("buzz",      rpc_buzz);
  Bridge.provide("stop_buzz", rpc_stop_buzz);
}

void loop() {
  // No polling needed — all actions are RPC-driven
}

